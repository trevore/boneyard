# Copied to ~/.zshrc.mac and sourced from ~/.zshrc by install.sh

# -U drops duplicate PATH entries, e.g. after re-sourcing this file. It only applies
# when assigning through the path array, not the PATH string, so use path=(...)
typeset -U path
path=(~/bin ~/.local/bin $path)

# Tab completion. Homebrew's completions are already on fpath (brew shellenv in ~/.zprofile)
autoload -Uz compinit && compinit

# Prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

alias k=kubectl
compdef k=kubectl

# Colorize ls (macOS BSD ls). eza gets its own aliases because its flags
# differ from ls (e.g. -t takes a value), so ls itself is left alone.
export CLICOLOR=1
# Same as the default except directories are bold blue (Ex), which iTerm2 shows as
# the brighter blue when "Use bright colors for bold text" is on
export LSCOLORS=Exfxcxdxbxegedabagacad
if command -v eza >/dev/null; then
  alias ll='eza --icons --git -l --group-directories-first'
  alias tree='eza --icons --tree'
fi

# History: keep a lot, write each command immediately, not shared live across tabs
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt EXTENDED_HISTORY
